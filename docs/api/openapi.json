  "components": {
    "schemas": {
      "DownloadJob": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Job id (UUID).",
            "examples": [
              "3f2b8c1e-9d4a-4b7e-8a51-0c2f6d9e1a77"
            ]
          },
          "source_id": {
            "type": "string",
            "title": "Source Id",
            "description": "Track being downloaded.",
            "examples": [
              "fJ9rUzIMcZQ"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "downloading",
              "ready",
              "failed"
            ],
            "title": "Status",
            "description": "Job state. Poll until `ready` or `failed`.",
            "examples": [
              "pending"
            ]
          },
          "song_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Song Id",
