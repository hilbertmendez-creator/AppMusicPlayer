{
  "openapi": "3.1.0",
  "info": {
    "title": "Mi Musica API",
    "description": "\nREST API of **Mi Musica**, a personal music and karaoke app.\n\n* Every endpoint except `/api/v1/health` requires `Authorization: Bearer <APP_TOKEN>`.\n* JSON uses snake_case; timestamps are ISO-8601 UTC; ids are UUID strings.\n* Errors are returned as `{\"detail\": \"...\"}`.\n",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health check",
        "description": "Liveness probe. Public: it is the only endpoint that needs no credentials.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/search": {
      "get": {
        "tags": [
          "search"
        ],
        "summary": "Search songs",
        "description": "Searches for songs to download. `mode=title` searches by title/artist, `mode=lyrics` treats `q` as a fragment of the lyrics (falling back to a plain search when the lyrics service is unavailable) and `mode=auto` merges both, title matches first. Results already in the library have `in_library=true`.",
        "operationId": "search_api_v1_search_get",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Title, artist or lyrics fragment.",
              "examples": [
                "bohemian rhapsody"
              ],
              "title": "Q"
            },
            "description": "Title, artist or lyrics fragment."
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "auto",
                "title",
                "lyrics"
              ],
              "type": "string",
              "description": "Search strategy.",
              "default": "auto",
              "title": "Mode"
            },
            "description": "Search strategy."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 20,
              "minimum": 1,
              "description": "Maximum number of results.",
              "default": 5,
              "title": "Limit"
            },
            "description": "Maximum number of results."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/downloads": {
      "post": {
        "tags": [
          "downloads"
        ],
        "summary": "Request a download",
        "description": "Queues the download of a search result (audio + lyrics) and returns immediately with a job. Poll `GET /downloads/{id}` until `status` is `ready` or `failed`. Idempotent: if the song is already in the library a `ready` job pointing at it is returned.",
        "operationId": "request_download_api_v1_downloads_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DownloadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DownloadJob"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
