    "/api/v1/songs/{song_id}/audio": {
      "get": {
        "tags": [
          "songs"
        ],
        "summary": "Download song audio",
        "description": "Streams the audio file with its media type (for example `audio/mp4` for m4a). HTTP `Range` requests are supported so players can seek.",
        "operationId": "get_audio_api_v1_songs__song_id__audio_get",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "song_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Song Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Full audio file.",
            "content": {
              "audio/mp4": {},
              "audio/*": {}
            }
          },
          "206": {
            "description": "Partial audio (Range request).",
            "content": {
              "audio/*": {}
            }
          },
          "401": {
            "description": "Missing or invalid bearer token.",
