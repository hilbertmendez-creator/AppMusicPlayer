<?xml version="1.0" encoding="utf-8"?>
<!--
  "Nota y letra": a white note plus three amber lyric lines on plum. Listening + singing along.
  Drawn on a 100-unit grid, scaled into the 66dp safe zone of the 108dp adaptive canvas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.75"
        android:scaleY="0.75"
        android:translateX="17.25"
        android:translateY="16.5">
        <!-- Note stem and flag -->
        <path
            android:pathData="M34,67 V28 L48,35"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- Note head -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M14.5,67 a10.5,8.5 0 1,0 21,0 a10.5,8.5 0 1,0 -21,0 Z" />
        <!-- Lyric lines -->
        <path
            android:pathData="M58,44 H80 M58,57 H80 M58,70 H71"
            android:strokeColor="#FFFFC857"
            android:strokeWidth="7"
            android:strokeLineCap="round" />
    </group>
</vector>
